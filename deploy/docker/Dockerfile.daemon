FROM node:22.23.2-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.29.2 --activate

FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm-build,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store --ignore-scripts
RUN node scripts/build-workspace.mjs

FROM base AS runtime
ENV NODE_ENV=production
ENV RAW_AGENT_DAEMON_HOST=0.0.0.0
ENV RAW_AGENT_DAEMON_PORT=37070
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml domains.manifest.json ./
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/daemon ./apps/daemon
COPY --from=build /app/apps/cli ./apps/cli
COPY --from=build /app/apps/web-console/package.json ./apps/web-console/package.json
COPY --from=build /app/apps/desktop/package.json ./apps/desktop/package.json
# Recreate production symlinks against this stage's own content-addressed store.
RUN --mount=type=cache,id=pnpm-runtime,target=/pnpm/store rm -rf packages/*/node_modules apps/*/node_modules && pnpm install --prod --frozen-lockfile --store-dir=/pnpm/store --ignore-scripts
EXPOSE 37070
CMD ["node", "apps/daemon/dist/server.js"]
