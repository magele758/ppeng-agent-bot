FROM node:22.23.2-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.29.2 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY . .
RUN --mount=type=cache,id=pnpm-build,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store --ignore-scripts
RUN pnpm exec tsc -b packages/api-types
RUN mkdir -p apps/web-console/public && pnpm run build:web-console

FROM node:22.23.2-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=33815
ENV HOSTNAME=0.0.0.0
ENV DAEMON_PROXY_TARGET=http://daemon:37070
COPY --from=build /app/apps/web-console/.next/standalone ./
COPY --from=build /app/apps/web-console/.next/static apps/web-console/.next/static
COPY --from=build /app/apps/web-console/public apps/web-console/public
EXPOSE 33815
CMD ["node", "apps/web-console/server.js"]
