# syntax=docker/dockerfile:1
# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/api-types/package.json      packages/api-types/
COPY packages/core/package.json           packages/core/
COPY packages/capability-gateway/package.json packages/capability-gateway/
COPY packages/agent-sre/package.json      packages/agent-sre/
COPY packages/agent-stock/package.json    packages/agent-stock/
COPY packages/agent-homeiot/package.json  packages/agent-homeiot/
COPY packages/agent-erp/package.json      packages/agent-erp/
COPY apps/daemon/package.json             apps/daemon/
COPY apps/cli/package.json                apps/cli/
COPY apps/web-console/package.json        apps/web-console/

RUN npm ci --ignore-scripts

# Lab depends on @ppeng/api-types only (not full agent-core).
# apps/web-console must not import packages/core; this stage does not COPY it.
COPY tsconfig.json tsconfig.base.json ./
COPY packages/api-types/ packages/api-types/
RUN npx tsc -b packages/api-types

RUN mkdir -p apps/web-console/public
COPY apps/web-console/ apps/web-console/

RUN npm run build:web-console

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=33815
ENV HOSTNAME=0.0.0.0
ENV DAEMON_PROXY_TARGET=http://daemon:37070

COPY --from=build /app/apps/web-console/.next/standalone ./
COPY --from=build /app/apps/web-console/.next/static      apps/web-console/.next/static
COPY --from=build /app/apps/web-console/public            apps/web-console/public

EXPOSE 33815
CMD ["node", "apps/web-console/server.js"]
