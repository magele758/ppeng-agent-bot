{
  "name": "@ppeng/agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-workspace.mjs && pnpm run build:web-console",
    "test": "pnpm run build && pnpm run test:unit",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=1 \"packages/core/test/**/*.test.js\" \"packages/core/test/**/*.test.ts\" \"packages/capability-gateway/test/**/*.test.js\" \"packages/agent-sre/test/**/*.test.js\" \"packages/agent-stock/test/**/*.test.js\" \"packages/agent-homeiot/test/**/*.test.js\" \"packages/agent-erp/test/**/*.test.js\" \"apps/web-console/lib/**/*.test.ts\" \"apps/web-console/components/**/*.test.ts\" \"apps/web-console/styles/**/*.test.ts\" \"apps/daemon/test/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"apps/desktop/src/**/*.test.ts\"",
    "test:always-on": "node --test --test-reporter=spec packages/core/test/always-on-reliability.test.js",
    "test:formal": "node scripts/formal/run-formal-regression.mjs",
    "test:pairing": "node scripts/formal/run-pairing-verification.mjs",
    "test:lifecycle": "node scripts/formal/run-lifecycle-verification.mjs",
    "test:acceptance": "node scripts/acceptance/acceptance-gate.mjs",
    "test:acceptance:results": "node scripts/acceptance/acceptance-gate.mjs --results coverage/acceptance/results",
    "test:acceptance:full": "node scripts/acceptance/acceptance-gate.mjs --collect unit,vitest,e2e",
    "ci:gate-health": "node scripts/ci/gate-health.mjs",
    "test:crap": "node scripts/crap/crap-gate.mjs",
    "test:package": "node scripts/publish-npm-packages.mjs --check",
    "test:crap:update": "node scripts/crap/crap-gate.mjs --update-baseline",
    "test:mutation": "node scripts/mutation/run-mutation.mjs",
    "test:regression": "node scripts/regression-test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "audit:upstream": "pnpm audit --registry=https://registry.npmjs.org",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:full": "node scripts/e2e-suite.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:pagelens": "node scripts/pagelens-smoke.mjs",
    "test:examples": "node scripts/run-core-examples.mjs",
    "ai:tools": "bash scripts/ai-cli/check-tools.sh",
    "ai:claude": "bash scripts/ai-cli/run-claude-fix.sh",
    "ai:codex": "bash scripts/ai-cli/run-codex-fix.sh",
    "ai:cursor": "bash scripts/ai-cli/run-cursor-agent-fix.sh",
    "test:remote": "node scripts/remote-smoke.mjs",
    "test:compact-ab": "node scripts/compact-ab-eval.mjs",
    "ci": "pnpm run build && pnpm run test:unit && pnpm run test:bot:soak:performance && pnpm run test:acceptance && pnpm run test:formal && pnpm run agent:eval:fast --exit-on-fail --out test-results/fast-eval && pnpm run agent:eval:verify && pnpm run test:package && pnpm run test:crap && pnpm run test:regression && pnpm run test:integration && pnpm run test:e2e",
    "start:daemon": "node apps/daemon/dist/server.js",
    "start:supervised": "node scripts/supervisor.mjs",
    "self-heal:flow": "bash scripts/self-heal-flow.sh",
    "start:cli": "node apps/cli/dist/index.js",
    "waveterm:parallel": "bash scripts/waveterm-parallel-blocks.sh",
    "dev:daemon": "pnpm exec tsc -b packages/core apps/daemon && node apps/daemon/dist/server.js",
    "dev:cli": "node --experimental-strip-types apps/cli/src/index.ts",
    "dev:web-console": "pnpm --filter @ppeng/agent-lab-web run dev",
    "evolution": "node scripts/evolution-cli.mjs",
    "evolution:preset:list": "node scripts/evolution-cli.mjs --list-presets",
    "evolution:cursor-composer": "node scripts/evolution-cli.mjs --preset cursor-composer",
    "evolution:cursor-composer:merge": "node scripts/evolution-cli.mjs --preset cursor-composer-merge",
    "evolution:learn": "node scripts/evolution-learn.mjs",
    "evolution:run-day": "node scripts/evolution-run-day.mjs",
    "evolution:pipeline": "bash scripts/evolution-pipeline.sh",
    "evolution:post-merge-reload": "bash scripts/evolution-post-merge-reload.sh",
    "evolution:showcase-build": "node scripts/build-evolution-showcase.mjs",
    "evolution:showcase-deploy": "node scripts/evolution-deploy-showcase.mjs",
    "evolution:drain-showcase": "bash scripts/evolution-drain-showcase.sh",
    "evolution:nightly": "bash scripts/evolution-nightly-wrap.sh",
    "evolution:pm2:start": "pm2 start ecosystem.evolution.config.cjs",
    "evolution:pm2:stop": "pm2 stop evolution-nightly",
    "evolution:pm2:restart": "pm2 restart evolution-nightly",
    "evolution:pm2:logs": "pm2 logs evolution-nightly",
    "evolution:pm2:delete": "pm2 delete evolution-nightly",
    "evolution:source-scores": "node scripts/evolution/source-score-report.mjs",
    "evolution:tag": "node scripts/evolution/capability-tagger.mjs",
    "doc:env": "node scripts/print-env-help.mjs --write",
    "agent-eval": "node scripts/agent-eval.mjs",
    "agent:eval": "node scripts/agent-eval/runner.mjs",
    "agent:eval:fast": "node scripts/agent-eval/runner.mjs --mode fast",
    "agent:eval:compare": "node scripts/agent-eval/compare.mjs",
    "agent:eval:verify": "node scripts/agent-eval/compare.mjs --config scripts/agent-eval/experiments/starter.json --simulation --trials 1",
    "experiment:tool-result-evict": "node scripts/experiment-tool-result-evict.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build:web-console": "pnpm --filter @ppeng/agent-lab-web run build",
    "start:web-console": "pnpm --filter @ppeng/agent-lab-web run start",
    "dev": "node scripts/dev-lab.mjs",
    "dev:lab": "pnpm run dev",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "release": "node scripts/release-orchestrator.mjs start",
    "release:git-sync": "node scripts/release-orchestrator.mjs git-sync",
    "release:promote": "node scripts/release-orchestrator.mjs promote",
    "release:rollback": "node scripts/release-orchestrator.mjs rollback",
    "release:status": "node scripts/release-orchestrator.mjs status",
    "release:observe": "node scripts/release-orchestrator.mjs observe",
    "build:desktop": "node scripts/build-desktop.mjs",
    "publish:npm": "node scripts/publish-npm-packages.mjs",
    "test:bot:faults": "node --test packages/core/test/bot-release-faults.test.js",
    "test:bot:release-evidence": "node scripts/bot-release/evidence.mjs",
    "test:restart": "node scripts/formal/run-restart-verification.mjs",
    "test:concurrency": "node scripts/formal/run-concurrency-verification.mjs",
    "test:acceptance:deployment": "node scripts/acceptance/acceptance-gate.mjs --stage all --out coverage/acceptance-deployment",
    "test:bot:soak:performance": "node scripts/bot-release/soak-performance.mjs",
    "agent:quality:baseline": "node scripts/agent-eval/compare.mjs --config scripts/agent-eval/experiments/bot-p0.json --baseline-only",
    "agent:quality:compare": "node scripts/agent-eval/compare.mjs --config scripts/agent-eval/experiments/bot-p0.json",
    "agent:quality:gate": "node scripts/agent-eval/quality-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3",
    "@ppeng/agent-core": "workspace:*",
    "@ppeng/agent-loop": "workspace:*",
    "@ppeng/api-types": "workspace:*",
    "next": "15.5.15",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "vscode-jsonrpc": "^8.2.1",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@10.29.2"
}
