{
  "name": "@ppeng/agent-core",
  "version": "0.1.0",
  "description": "Embeddable multi-agent runtime SDK: sessions, tools, approvals, workspaces, storage, model adapters, domain bundles.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ppeng/agent-loop": "0.1.4",
    "@ppeng/api-types": "0.1.4",
    "jsonrepair": "^3.12.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "vscode-jsonrpc": "^8.2.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  },
  "//": "sharp moved to optionalDependencies — lazy-loaded in src/image-assets.ts so installs that skip it (e.g. unsupported arch) still produce a working agent (contact-sheet retention disabled).",
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/exports/types.d.ts",
      "default": "./dist/exports/types.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./turn": {
      "types": "./dist/turn/index.d.ts",
      "default": "./dist/turn/index.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "default": "./dist/loop.js"
    },
    "./session-query": {
      "types": "./dist/session-query.d.ts",
      "default": "./dist/session-query.js"
    }
  }
}
