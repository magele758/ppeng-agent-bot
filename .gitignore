node_modules/
# 环境变量（忽略所有本地 env 配置，保留模版）
.env
.env.*
.env*.local
!.env.example
!.env.k8s.example
!.env.*.example
!**/.env.example
!**/.env.k8s.example
!**/.env.*.example

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

dist/
coverage/
packages/*/coverage/
*.tsbuildinfo
.agent-state/
# Local SSH credentials and isolated E2E workspace copies.
.agent-ssh/
.e2e-web-tmp/
# Playwright persistent profiles (cookies / local storage). Never commit.
browser-profiles/
.evolution-worktrees/
.evolution/
.cursor/
.claude/
