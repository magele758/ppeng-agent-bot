prototypes/
test-results/
.eval-baseline/
playwright-report/
playwright/.cache/
.next/
apps/web-console/.next/

# evolution 自动生成的运行记录（不跟踪，减少 merge 冲突）
doc/evolution/success/
doc/evolution/failure/
doc/evolution/skip/
doc/evolution/no-op/
doc/evolution/superseded/
doc/evolution/runs/
doc/evolution/inbox/
doc/evolution/archive/
# evolution 自动生成的技能摘要（每次 learn 都会更新）
skills/agent-tech-digest/*.md.gz
skills/agent-tech-digest/SKILL.md
gateway.config.json

# Desktop client build artifacts
apps/desktop/dist/
apps/desktop/release/
apps/desktop/server-bundle/
apps/desktop/node_modules/
apps/desktop/assets/icon.icns
apps/desktop/assets/trayTemplate.png
apps/desktop/assets/trayTemplate@2x.png

# macOS Finder metadata
.DS_Store

# pi 会话记录（含本机路径/用户名/对话隐私，勿提交）
.pi/sessions/

# 本地临时文件/截图，不入库
/tmp/

# Local agent harness scripts
/.raw-agent-harness/
