# Raw Agent SDK 配置示例
# 复制为 .env 并填写实际值: cp .env.example .env
#
# 须为 bash 可 `source` 的 KEY=value；勿粘贴 YAML（如单独一行 `run: deploy` 会报「run: 未找到命令」）。
# 含空格的命令须加引号，例如 EVOLUTION_TEST_CMD='npm run test:unit'（否则 `run` 会被当成独立命令执行）。
#
# 完整变量索引（自动生成 / 含每个 KEY 的引用文件清单）：doc/ENV_REFERENCE.md
#   生成命令：npm run doc:env
# CI / GitHub Actions：见 docs/CI.md（每次 push/PR 自动 build+测试；可选 Secrets 跑真模型冒烟）

# 模型：日常请在对话区「配置模型」（或「更多 → 模型服务商」）填 Base URL / API Key，
# 自动发现模型列表后在对话里选择（立即生效，无需重启）。
# 下列 RAW_AGENT_MODEL_* 仅作 CI / 从未在界面保存过时的回退。
# 模型提供商回退: heuristic | openai-compatible | anthropic-compatible
RAW_AGENT_MODEL_PROVIDER=heuristic

# OpenAI 兼容 API (chat completions)
RAW_AGENT_BASE_URL=https://api.openai.com/v1
RAW_AGENT_API_KEY=sk-your-api-key
RAW_AGENT_MODEL_NAME=gpt-4
# 文本/VL 适配器 HTTP 形态：chat_completions（默认 /v1/chat/completions）| responses（POST /v1/responses）
# Opt-in 风险：仅适合 OpenAI 官方或完整实现 Responses 的网关；多数「仅 chat completions」的兼容/VL 端点会报错。
# 多轮工具会话需服务端支持 Responses 的 input 条目（function_call / function_call_output / message 内容块），不要与 Chat 的 messages 混用。
# RAW_AGENT_OPENAI_HTTP_KIND=responses
# VL 适配器默认继承上述 HTTP 形态；若文本走 `/responses` 而 VL 端点仅支持 chat completions，可单独强制：
# RAW_AGENT_VL_OPENAI_HTTP_KIND=chat_completions
# 控制 OpenAI 兼容适配器在 summary 压缩时是否发送 response_format=json_object
# 当 `RAW_AGENT_OPENAI_HTTP_KIND=responses` 时 compact 摘要走 Responses 的纯文本 output（非 json_object），勿依赖 `{"summary":...}` 结构
# 若第三方 API 不支持 response_format，设为 0 或 false
# RAW_AGENT_USE_JSON_MODE=0

# --- 视觉 / VL（openai-compatible 时可选；配了模型 + 端点/key 即自动 hybrid-router，含图消息走 VL；没配则图片走主模型）---
# RAW_AGENT_VL_MODEL_NAME=qwen-vl-plus
# RAW_AGENT_VL_BASE_URL=https://api.example.com/v1
# RAW_AGENT_VL_API_KEY=
# RAW_AGENT_VL_USE_JSON_MODE=0
# 何时走 VL：any（任一条消息含图）| last_user（仅当最后一轮用户消息含图）
# RAW_AGENT_VL_ROUTE_SCOPE=any
# 图片：单文件最大字节；热图保留数量；关键帧模型（关掉则仅用启发式抽样）
# RAW_AGENT_IMAGE_MAX_BYTES=12000000
# RAW_AGENT_IMAGE_FETCH_TIMEOUT_MS=30000
# RAW_AGENT_IMAGE_HOT_LIMIT=3
# RAW_AGENT_IMAGE_WARM_KEYFRAME_LIMIT=4
# RAW_AGENT_IMAGE_CONTACT_SHEET_GRID=2
# RAW_AGENT_IMAGE_RETENTION_DAYS=30
# RAW_AGENT_IMAGE_KEYFRAME_MODEL=1

# Anthropic 兼容 API (可选)
# RAW_AGENT_ANTHROPIC_URL=https://api.anthropic.com/v1

# E2E/CI：由 scripts/e2e-run.mjs 自动设为 1，daemon 内会强制 heuristic 并忽略远程 OpenAI 等，避免本机 .env 污染自动化
# RAW_AGENT_E2E_ISOLATE=1

# Next 控制台本地代理 daemon（npm run dev:web-console / start:web-console 时在 shell 里 export）
# DAEMON_PROXY_TARGET=http://127.0.0.1:37070

# Daemon
RAW_AGENT_DAEMON_HOST=127.0.0.1
RAW_AGENT_DAEMON_PORT=27070
# CLI（@ppeng/daemon-client）可选：整体覆盖 base URL，优先于 HOST/PORT
# RAW_AGENT_DAEMON_BASE_URL=http://127.0.0.1:27070
# Next Lab 首选端口（npm run dev:lab）；冲突时向后 +1… 退避
# RAW_AGENT_WEB_PORT=23000
# RAW_AGENT_PORT_SPAN=20
# 浏览器跨域：逗号分隔 Origin，或 *（慎用）
# RAW_AGENT_CORS_ORIGIN=http://127.0.0.1:33815

# 状态目录
# RAW_AGENT_STATE_DIR=.agent-state

# --- 多副本 / 云存储：配了就自动启用，不配就是本地（SQLite + 本地盘），无需任何开关 ---
# 优先级：显式 RAW_AGENT_*_PROVIDER > Lab 持久化 > 下面这些连接信息 > 自动推断 > 本地兜底。
# 「Lab → 更多 → 运行模式 / 有效配置」（GET /api/config/effective）可看到每项到底生效了什么、为什么。
# DATABASE_URL 配了 → 事件缓冲(redis_postgres) + 技能注册表(pg_redis) 走 PG（先执行
#   packages/core/src/storage/migrations/pg/001_initial.sql；连不上或缺表会 warn 并回退本地，不阻止启动）。
#   注意：会话库目前仍是 SQLite，配 DATABASE_URL 不会把会话迁进 PG。
# REDIS_URL 配了 → 调度锁走 Redis（连不上自动退回进程内锁）；也用作 PG 档的可选缓存。
# RAW_AGENT_S3_{ENDPOINT,BUCKET,ACCESS_KEY,SECRET_KEY} 配齐 → 资产自动分层存储；只配一部分会 warn 并回退本地。
# DATABASE_URL=postgresql://user:pass@host:5432/db
# REDIS_URL=redis://127.0.0.1:6379
# RAW_AGENT_S3_ENDPOINT=http://127.0.0.1:9000
# RAW_AGENT_S3_BUCKET=ppeng-assets
# RAW_AGENT_S3_ACCESS_KEY=minioadmin
# RAW_AGENT_S3_SECRET_KEY=minioadmin
# RAW_AGENT_S3_PREFIX=skills/
# RAW_AGENT_S3_REGION=us-east-1
# 高级覆盖（一般不用设；显式值永远优先，含显式 local/sqlite；强制云档却缺依赖才会报错退出）：
#   RAW_AGENT_DEPLOYMENT_MODE / SESSION_STORE_PROVIDER / EVENT_BUFFER_PROVIDER /
#   SKILL_REGISTRY_PROVIDER / ASSET_STORAGE_PROVIDER / DISPATCH_LOCK_PROVIDER
# RAW_AGENT_EVENT_BUFFER_PROVIDER=local
# Redis 调度互斥锁租约(ms)；tick 期间会按约 TTL/3 间隔续租，结束前释放。
# RAW_AGENT_DISPATCH_LOCK_TTL_MS=8000
# RAW_AGENT_DEFAULT_TENANT_ID=default
# RAW_AGENT_DEFAULT_USER_ID=default
# RAW_AGENT_EVENT_BUFFER_META_TTL_SEC=86400
# RAW_AGENT_SKILL_REGISTRY_CACHE_TTL_SEC=300
# RAW_AGENT_TIERED_CACHE_DIR=.agent-state/tiered-cache
# RAW_AGENT_TIERED_LRU_MAX_KEYS=10000

# 上下文压缩：估算 token 阈值（约 4 字符/token）；滚动摘要字符上限（不设则默认 = 阈值×2，与估算口径一致）
# 两个「历史预算」（压缩阈值 / episodic 选择）**不设时按模型上下文窗口推导**
#（窗口 − system prompt − 工具 schema − 输出预留 − 安全余量，下限 8000），显式设值仍优先。
# 换大窗口模型只需改 RAW_AGENT_MODEL_CONTEXT_TOKENS，别再手调这两个阈值。
# RAW_AGENT_COMPACT_TOKEN_THRESHOLD=24000
# RAW_AGENT_COMPACT_SUMMARY_MAX_CHARS=48000
# 模型上下文窗口（推导历史预算用；不设默认 131072）
# RAW_AGENT_MODEL_CONTEXT_TOKENS=131072
# 为模型输出预留的 token（推理模型常吐几万，预留过小 = 长会话答到一半被截）
# RAW_AGENT_OUTPUT_RESERVE_TOKENS=16000

# 微压缩（每轮）：模型已消费过的旧 tool_result 收成一行占位，只改「送给模型的视图」，
# 落库 transcript 仍是全量。补 autoCompact 的空档——后者只在整体过阈值时才跑一次 LLM 摘要。
# RAW_AGENT_MICRO_COMPACT=1
# RAW_AGENT_MICRO_COMPACT_KEEP_RECENT=3
# RAW_AGENT_MICRO_COMPACT_MIN_CHARS=100
# RAW_AGENT_MICRO_COMPACT_HARD_MAX_CHARS=12000

# Working log：每 session 一份 append-only `working-memory.md`（stateDir/working-logs/<sid>/），
# 只记高信号（压缩锚点 + 归档 transcript 路径、步骤结论）；尾部随 memory appendix 走 user 侧注入，
# 使被压缩掉的会话仍留有可追溯线索。压缩是有损的，这是它的外存兜底。
# RAW_AGENT_WORKING_LOG=1
# RAW_AGENT_WORKING_LOG_TAIL_CHARS=4000
# 会话记忆后端：agent（默认，写入 agent_memory 五层）| session（仅 session_memory 表）| dual（双写过渡）
# RAW_AGENT_MEMORY_BACKEND=agent
# Optional Bearer for /api/*（health/readiness/version 免检）。启用时 Next middleware 同源代理会服务端补 Authorization（与 Daemon 填同一值）。
# RAW_AGENT_AUTH_TOKEN=

# Lab 账号（Google / GitHub OAuth）。配齐 client id+secret 后，所有 /api/* 都需登录，资源按账号隔离
# （省略 x-ppeng-lab 头不再绕过；仅「无 Lab 头 + RAW_AGENT_AUTH_TOKEN Bearer」的 CLI/运维调用不隔离）。
# 首个登录用户成为租户 owner；全局设置/密钥/自愈等管理路由只对租户 owner/admin 开放，
# 用 PUT /api/tenants/:id/members/:userId {"role":"admin"} 授权。路由访问级别见 apps/daemon/src/access/policy.ts。
# 未设 RAW_AGENT_GATEWAY_TOKEN 时，capability-gateway 路径回落到 RAW_AGENT_AUTH_TOKEN Bearer 校验。
# 回调地址填 {RAW_AGENT_OAUTH_PUBLIC_ORIGIN}/api/auth/google/callback 与 /api/auth/github/callback
# RAW_AGENT_OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:33815
# RAW_AGENT_OAUTH_GOOGLE_CLIENT_ID=
# RAW_AGENT_OAUTH_GOOGLE_CLIENT_SECRET=
# RAW_AGENT_OAUTH_GITHUB_CLIENT_ID=
# RAW_AGENT_OAUTH_GITHUB_CLIENT_SECRET=

# 单轮并行执行的工具调用数上限
# RAW_AGENT_MAX_PARALLEL_TOOLS=8

# Skills：除仓库 `skills/**/SKILL.md` 外，默认递归加载 ~/.agents/**/SKILL.md；同名时 ~/.agents 覆盖仓库
# RAW_AGENT_AGENTS_SKILLS=0
# RAW_AGENT_AGENTS_SKILLS_DIR=/custom/path

# Skill 路由：legacy=全文广播 meta + 关键词 Matched；lexical=仅词法 shortlist；hybrid=词法 shortlist ∪ 关键词命中（默认）
# RAW_AGENT_SKILL_ROUTING_MODE=hybrid
# RAW_AGENT_SKILL_ROUTING_TOP_K=8
# 为 1 时 load_skill 仅限当轮 shortlist（否则仍可加载未列出 skill，并写入 trace）
# RAW_AGENT_SKILL_LOAD_STRICT=0

# --- 智能体失范 / 运行时策略附录（非训练层；见 doc/AGENTIC_SAFETY_RUNTIME.md）---
# 为 1 / general / true 时：仅对内置 `general` 智能体在系统前缀末尾追加英文安全附录（拒绝以伤害用户/他人完成目标、工具冲突时暂停询问等）。
# 为 all 时：对所有智能体追加同一段。关闭：留空或 0 / false / off。
# RAW_AGENT_AGENTIC_SAFETY_APPENDIX=1
# RAW_AGENT_AGENTIC_SAFETY_APPENDIX=all

# --- Evolution（自我进化：npm run evolution:pipeline / evolution:learn / evolution:run-day）---
#
# ★ 完整链路（研究 → Codex 规划 → Claude 实现 → Gemini 测试补强 → 单测 → Codex 审查 + Claude 精炼 → rebase → 合并主分支）
#   已按执行顺序写好全部变量（无 API 密钥），见：scripts/evolution-quality-pipeline.env.example
#   仓库根目录执行合并到本地配置：
#     cat scripts/evolution-quality-pipeline.env.example >> .env
#   再按需改 EVOLUTION_TARGET_BRANCH、EVOLUTION_AUTO_MERGE、EVOLUTION_CONCURRENCY 等。
#   一键跑：npm run evolution:pipeline
#   「长参数捷径」：`npm run evolution:cursor-composer` 或 `npm run evolution -- --preset cursor-composer`（可再跟 `--merge`/`--concurrency 5` 覆盖）；预设见 scripts/evolution-presets.json，列表：`npm run evolution:preset:list`
#   片段内 EVOLUTION_PIPELINE_USE_ENV_AGENT=1：pipeline 才会沿用片段里的 EVOLUTION_AGENT_CMD（否则 pipeline 会强制覆盖为 Claude）。
#
# gateway：RSS 在 gateway.config.json 的 learn.feeds（或 EVOLUTION_GATEWAY_CONFIG）
# Node 自带 fetch 的 TCP 连接阶段默认约 10s，国际链路或 IPv6 易超时；evolution:learn 已用更长超时 + 默认 IPv4 优先。
# 仍失败时：与浏览器对齐代理（Clash 等）例如 HTTPS_PROXY=http://127.0.0.1:7890
# RAW_AGENT_FEED_CONNECT_TIMEOUT_MS=45000
# RAW_AGENT_FEED_HEADERS_TIMEOUT_MS=45000
# RAW_AGENT_FEED_BODY_TIMEOUT_MS=120000
# RAW_AGENT_FEED_FETCH_TIMEOUT_MS=120000
# RSS 抓取遇到 5xx / 网络抖动时的最大尝试次数（默认 2）
# RAW_AGENT_FEED_MAX_ATTEMPTS=2
# 对指定主机跳过 TLS 证书校验（逗号分隔）。留空字符串=严格校验；未设置时默认含 nitter.net（多数实例证书不可用）
# RAW_AGENT_FEED_INSECURE_TLS_HOSTS=nitter.net
# RAW_AGENT_FEED_INSECURE_TLS_HOSTS=
# RAW_AGENT_FEED_IPV4_FIRST=0
# RAW_AGENT_HTTPS_PROXY=http://127.0.0.1:7890
# EVOLUTION_GATEWAY_CONFIG=./gateway.config.json
# 本地 / Obsidian：逗号分隔多目录，每层子目录都会递归扫 .md/.txt；正文无 http 链接时整篇为一条（file://）。
# 可单独使用（不配 RSS）：目录须存在，且 `gateway.config.json` 的 `learn.feeds` 可设为空数组 `[]`。
# EVOLUTION_LOCAL_SOURCES="/path/vault/A,/path/vault/B"
# EVOLUTION_LOCAL_SOURCES=/path/to/obsidian-vault/YourInbox
# EVOLUTION_LOCAL_SOURCES=.evolution/sources/,doc/evolution/local/
# EVOLUTION_ARCHIVE_DIR=doc/evolution/archive/
#
# Worktree .env 复制策略（默认按白名单写出，不含 API Key 等敏感键，避免多并发 worktree 扩散 secret）：
#   - EVOLUTION_SKIP_COPY_ENV=1           完全跳过
#   - EVOLUTION_ENV_FILE=path/to/file     显式整文件覆盖（拷贝该文件而非按白名单生成）
#   - EVOLUTION_ENV_PASSTHRU_KEYS=A,B     在默认白名单（EVOLUTION_*/RAW_AGENT_GATEWAY_*/RAW_AGENT_FEED_*）外追加键
#
# 片段未覆盖或需临时覆盖的开关（见 scripts/evolution-quality-pipeline.env.example 内注释块）：
# EVOLUTION_SKIP_PIPELINE_BUILD=0
# EVOLUTION_AGENT_CMD='bash scripts/evolution-agent-hook.example.sh'
# npm run evolution -- --agent full   # run-day，强制使用 evolution-agent-full.sh（研究+多CLI路由）
# 未设置 EVOLUTION_TARGET_BRANCH 时回退 RAW_AGENT_SELF_HEAL_TARGET_BRANCH，再默认 main
# EVOLUTION_AGENT_CONSTRAINTS_FILE=doc/evolution/agent-constraints.md
# EVOLUTION_AGENT_CONSTRAINTS=
# evolution CLI 输入过长截断（见 scripts/evolution-run-day.mjs 注释）
# EVOLUTION_AGENT_EXCERPT_MAX_CHARS=22000
# EVOLUTION_AGENT_CONSTRAINTS_MAX_CHARS=24000
# 研究阶段：strict=极保守（少噪音，默认建议）| balanced=默认 | recall=更不易漏有价值条目
# EVOLUTION_RESEARCH_STRICTNESS=strict
# 模型输出无法解析出首行 PROCEED/SKIP 时：skip=放弃本条（少噪音）| proceed=继续研发
# EVOLUTION_RESEARCH_UNPARSED_DEFAULT=skip
# 判定「长摘录」阈值（字符数，用于 full vs weak 源强度）；弱源仍可依赖标题+URL 做研究
# EVOLUTION_RESEARCH_FULL_EXCERPT_MIN_CHARS=500
# EVOLUTION_AGENT_PLAN_MAX_CHARS=32000
# EVOLUTION_AGENT_CLI_PROMPT_MAX_CHARS=96000
# run-day / `npm run evolution` 的并发 worktree 上限（默认 5，硬顶 200）；需更大 `--concurrency` 时先调大此项
# 未设置时 CLI/run-day 允许的最大并发 worktree 数（默认 32；硬顶见 scripts/evolution/agent-prompts.mjs）
# EVOLUTION_CONCURRENCY_MAX=64
# 同一自然日内 EVOLUTION_ROUNDS_PER_DAY>1 时，两轮 run-day 之间的等待（毫秒）。默认 0 不等待。
# EVOLUTION_ROUND_INTERVAL_MS=0
# `npm run evolution -- --until-empty` 时单次命令内最多调用 run-day 次数（防止异常死循环），默认 500
# EVOLUTION_UNTIL_EMPTY_MAX_RUNS=500
#
# --- PM2 定时 evolution（ecosystem.evolution.config.cjs + scripts/evolution-nightly-wrap.sh）---
# 需全局安装：npm i -g pm2。手动单次：npm run evolution:nightly
# PM2 启动：npm run evolution:pm2:start；日志：npm run evolution:pm2:logs
# 不设 cron（仅 pm2 启动时跑一轮）：启动前 export EVOLUTION_PM2_CRON=
# 覆盖默认 06:30：EVOLUTION_PM2_CRON='0 2 * * *'
# EVOLUTION_PM2_CRON=30 6 * * *
# 传给 `npm run evolution --` 的额外参数（空格分隔；未设置则用脚本内默认：pipeline-build + learn + cursor + codex review + 5 并发 + 200 条）
# EVOLUTION_PM2_EVOLUTION_ARGS=--pipeline-build --learn --agent claude --review codex --concurrency 3 --items 50
# 跑完 evolution 后是否执行 showcase-deploy（1=是，默认 1）
# EVOLUTION_PM2_RUN_SHOWCASE=1
# 整段最长运行时间（需系统有 timeout 或 brew 的 gtimeout），例如 8h、3600s
# EVOLUTION_PM2_TIMEOUT=8h
#
# run-day 本轮条目全部跑完后，可选自动构建展示站并同步到本地 GitHub Pages 克隆目录
# 首页/Pages 源仓库：git clone https://github.com/magele758/magele758.github.io.git
# EVOLUTION_SHOWCASE_PAGES_GIT_URL=https://github.com/magele758/magele758.github.io.git
# EVOLUTION_SHOWCASE_AUTO_DEPLOY=1
# EVOLUTION_SHOWCASE_DEPLOY_DIR=/绝对路径/magele758.github.io
# EVOLUTION_SHOWCASE_GIT_PUSH=1
# 与远程同步方式：reset（默认，fetch + reset --hard，适合纯生成首页）| rebase（git pull --rebase，易与历史 showcase 提交冲突）
# EVOLUTION_SHOWCASE_GIT_SYNC_MODE=reset
# 目标分支（与本地检出不一致时显式指定，如 GitHub Pages 仍为 master）
# EVOLUTION_SHOWCASE_GIT_REMOTE_BRANCH=master
# 从 dist 拷到 Pages 根目录的白名单（避免 git add 误纳入 node_modules 等）；与 magele758.github.io 静态根目录一致
# EVOLUTION_SHOWCASE_DEPLOY_ARTIFACTS=index.html,styles.css,app.js,data
# 复制后在 Pages 仓执行的命令（可选，如 Astro：npm ci && npm run build）
# EVOLUTION_SHOWCASE_POST_COPY_CMD=
# 展示站 JSON 中合并提交直链（success 的 merge_commit → GitHub commit 页）
# EVOLUTION_SHOWCASE_GITHUB_REPO=owner/repo
# 或自定义前缀（到 …/commit 为止，不含 SHA）：https://github.com/org/repo/commit
# EVOLUTION_SHOWCASE_COMMIT_URL_PREFIX=https://github.com/org/repo/commit
# Evolution 里走 Cursor agent 时：`agent --model`（默认 composer-2-fast）
# EVOLUTION_CURSOR_AGENT_MODEL=composer-2-fast

# Evolution 2.0 集成开关（默认全部关闭）
# EVOLUTION_USE_ORCHESTRATOR=0     # 1 = 每条 item 处理时调用 daemon POST /api/orchestration/runs，并在完成/失败时 PATCH 状态
# EVOLUTION_MERGE_RISK_CHECK=0     # 1 = 合并前按 capability_tags 判断 risk_level：low=自动合并；medium=警告后合并；high=跳过合并写 backlog
# EVOLUTION_HARNESS_GATE=0         # 1 = 合并前执行 node scripts/agent-eval/runner.mjs --mode fast --exit-on-fail；失败则跳过合并
# 模型 runTurn 失败重试次数
# RAW_AGENT_MODEL_MAX_RETRIES=2

# bash 默认超时（毫秒）
# RAW_AGENT_BASH_TIMEOUT_MS=120000

# work_evidence：裁剪 git status/diff stat 与 verify 命令 stdout/stderr 的单段最大字符数。
# 仅当值 ≥4096 时按配置生效，否则回退 120000；硬上限 2000000。
# verify 超时：未传 verify_timeout_ms 时与 bash 相同，依次使用 RAW_AGENT_BASH_TIMEOUT_MS，再默认 120000；传了 verify_timeout_ms 则优先。
# RAW_AGENT_WORK_EVIDENCE_DIFF_MAX_CHARS=120000

# --- Sandbox（子进程沙箱）---
# 控制 bash / bg_run 等工具的执行隔离级别。
# auto（默认）: macOS 用 sandbox-exec（Tier 1），Linux 有 bwrap 则用，否则仅 env 净化（Tier 0）
# direct: 仅 Tier 0（环境变量净化：剥离 LD_PRELOAD / NODE_OPTIONS / DYLD_INSERT_LIBRARIES 等注入向量）
# os: 强制使用 OS 级沙箱（不可用时降级为 direct）
# container: 预留 Tier 2（Docker/Podman，尚未实现）
# RAW_AGENT_SANDBOX_MODE=auto
# bash / bg_run / work_evidence 会显式 allowNetwork，因此 auto 下 curl、npm install、git fetch、gh 仍能出网。
# 没传 allowNetwork 的沙箱调用保持断网。工具子进程默认剥 RAW_AGENT_* 的 key/token/secret，不设白名单：
# 模型、VL、飞书、OAuth、daemon 鉴权在宿主进程读这些变量。GH_TOKEN / NPM_TOKEN 同样不进子进程。

# Agent 执行后端（bash / bg_run）：与上项正交；native=本机 Tier0+Tier1；remote_vm=E2B 类 HTTP 适配；microservice=独立 Runner 服务
# RAW_AGENT_AGENT_SANDBOX_KIND=native
# E2B-like：适配服务基址，需实现 POST {base}/exec → JSON { stdout, stderr, code }
# RAW_AGENT_SANDBOX_REMOTE_URL=
# 微服务 Runner：POST {base}/run → 同上（可与 remote 共用同一实现，仅入口路径不同）
# RAW_AGENT_SANDBOX_RUNNER_URL=

# 为 true/1 时，向模型挂载工具 claude_code / codex_exec / cursor_agent，可在会话内自主调用外部 CLI（需本机 PATH 有对应命令；默认每次调用需审批）
# RAW_AGENT_EXTERNAL_AI_TOOLS=1
# cursor_agent 调用 `agent --print` 时固定模型（默认 composer-2-fast，避免误用更贵模型）
# RAW_AGENT_CURSOR_AGENT_MODEL=composer-2-fast

# --- Self-heal（CLI：`npm run start:cli -- self-heal start`；HTTP：`POST /api/self-heal/start`）---
# 自愈子进程会自动把 node 同目录、/opt/homebrew/bin、/usr/local/bin、/usr/bin  prepend 到 PATH，缓解 spawn npm/git ENOENT。
# 仍失败可显式指定：RAW_AGENT_NPM_BIN、RAW_AGENT_GIT_BIN（绝对路径）。
# RAW_AGENT_NPM_BIN=
# RAW_AGENT_GIT_BIN=
# RAW_AGENT_SELF_HEAL_TEST_PRESET=unit
# RAW_AGENT_SELF_HEAL_CUSTOM_SCRIPT=myscript
# RAW_AGENT_SELF_HEAL_MAX_ITERATIONS=5
# 合并到当前目标分支并产生 merge commit；推远端为可选（需本机已配置 remote/凭证）
# RAW_AGENT_SELF_HEAL_AUTO_MERGE=0
# RAW_AGENT_SELF_HEAL_GIT_PUSH=0
# RAW_AGENT_SELF_HEAL_GIT_REMOTE=origin
# 合并后请求 supervisor 重启 daemon（需 `npm run start:supervised`，见 scripts/supervisor.mjs）
# RAW_AGENT_SELF_HEAL_AUTO_RESTART=0
# RAW_AGENT_SELF_HEAL_TARGET_BRANCH=main
# RAW_AGENT_SELF_HEAL_AGENT_ID=self-healer
# Allow self-heal agent to call claude_code/codex_exec/cursor_agent without approval
# (requires RAW_AGENT_EXTERNAL_AI_TOOLS=1 and the CLI to be on PATH)
# RAW_AGENT_SELF_HEAL_ALLOW_EXTERNAL_AI=0
# Daemon 启动时自动发起一次 self-heal（policy 仍来自下方 RAW_AGENT_SELF_HEAL_*；与「已有活跃 run」冲突时跳过）
# RAW_AGENT_SELF_HEAL_AUTO_START=0
# merge 前主仓有未提交改动时自动 git stash push -u，merge 成功后 stash pop（失败会 blocked 并提示）
# RAW_AGENT_SELF_HEAL_AUTO_STASH_MAIN=0
#
# 「持续自我进化」最小闭环（本地）：start:supervised + AUTO_MERGE + AUTO_RESTART + AUTO_STASH_MAIN；
# 远端同步：再开 SELF_HEAL_GIT_PUSH=1。「读论文→实验→合主线」尚无内置调度，需另做定时任务/Agent 会话编排。

# 设为 1 且使用 openai-compatible 时，daemon / runSession(stream) 可走 SSE 流式
# RAW_AGENT_STREAM=1

# 拒答保持守卫：检测 assistant 拒答后紧跟的短前缀重定向攻击（arXiv:2604.08557），
# 自动注入保护性提醒以锚定模型的先前拒答决策。默认开启；设为 0 关闭。
# RAW_AGENT_REFUSAL_PRESERVATION=1

# 审批策略 JSON，例如: {"defaultRisky":true} 或 {"rules":[{"toolPattern":"write_*","match":"glob","when":"always"}]}
# RAW_AGENT_APPROVAL_POLICY=

# MCP：配了 URL / stdio 就自动挂载，没配就不暴露 mcp_* 工具。
# Streamable HTTP（官方 SDK）。JSON 数组，密钥只放环境变量名或 RAW_AGENT_MCP_BEARER，不要写进本文件。
# [{ "url": "http://127.0.0.1:8795/mcp", "bearerEnv": "AGENT_ROOM_TOKEN", "headers": { "X-Trace": "1" }, "transport": "streamable-http" }]
# transport 省略或 streamable-http；旧 SSE 端点设 "sse"。401/406 不会退回 SSE。
# RAW_AGENT_MCP_HTTP=
# 与下面旧 URL 列表逐项对齐的 Bearer（只按逗号分隔）。JSON 条目已有 Authorization / bearerEnv 时不覆盖。
# RAW_AGENT_MCP_BEARER=
# 旧 HTTP MCP 地址，逗号或空格分隔。与 RAW_AGENT_MCP_HTTP 重复的 URL 以 JSON 为准。
# RAW_AGENT_MCP_URLS=http://127.0.0.1:3030/mcp
# MCP stdio：JSON 数组，每项 { "command": "npx", "args": ["-y","@modelcontextprotocol/server-memory"] }
# RAW_AGENT_MCP_STDIO=
# 为 0 时不把 stdio 上 tools/list 展开成独立工具名（仍可有 mcp_list_resources / mcp_read_resource）
# RAW_AGENT_MCP_EXPAND_STDIO=1
# MCP tool JSON Schema minification for LLM prompts: 0=off 1=light (default) 2=aggressive
# RAW_AGENT_MCP_SCHEMA_MINIFY=1
# 为 1 时把 HTTP MCP 的 tools/list 也展开成 mcp_h0_* 工具
# RAW_AGENT_MCP_EXPAND_HTTP=0

# web_fetch：最大字节；默认拦截私网 IP，设为 1 允许（慎用）
# RAW_AGENT_WEB_FETCH_MAX_BYTES=2000000
# RAW_AGENT_WEB_FETCH_ALLOW_PRIVATE=0
# web_search：模板 URL，{query} 会被编码替换；配了即启用，不设则不暴露该工具（Lab「附件与浏览器」里保存的模板优先于此 env）
# RAW_AGENT_WEB_SEARCH_URL=

# Jupyter：为 1 时启用 notebook_edit 工具
# RAW_AGENT_NOTEBOOK_TOOLS=0

# A2UI（Agent-to-UI v0.9，doc/A2UI.md）：为 1 时暴露 a2ui_render / a2ui_delete_surface
# 工具，agent 可在 Agent Lab 对话气泡里渲染交互式 surface（卡片 / 表单 / 任务列表 …）。
# 默认 catalog 见 skills/a2ui/SKILL.md，关键字触发再注入。
# RAW_AGENT_A2UI_ENABLED=0

# Domain Agents（doc/DOMAIN_AGENTS.md）：不设 RAW_AGENT_DOMAINS 时，检测到下面的 SRE_* / STOCK_* 连接信息
# 就自动挂载对应只读领域包（sre / stock）；显式设了 CSV（哪怕为空）则以 CSV 为准，未列出则不加载。
# homeiot / erp 涉及设备控制与写入，永远只在 CSV 里显式开启。
# RAW_AGENT_DOMAINS=sre,stock

# --- SRE 域 (@ppeng/agent-sre) ---
# Prometheus 基址；可选 Bearer token
# SRE_PROM_URL=http://prometheus:9090
# SRE_PROM_TOKEN=
# Loki 基址；可选 Bearer token
# SRE_LOKI_URL=http://loki:3100
# SRE_LOKI_TOKEN=
# k8s_get 用：kubeconfig 路径（未设时 fallback 到 KUBECONFIG）
# SRE_KUBECONFIG=
# PagerDuty REST API key
# SRE_PAGERDUTY_TOKEN=

# --- Stock 域 (@ppeng/agent-stock) ---
# 数据源切换：yahoo（默认，无需密钥但有速率限制）/ alphavantage（需 key）/ mock（CI 离线友好）
# STOCK_QUOTE_PROVIDER=yahoo
# Alpha Vantage 免费 API key（仅当 provider=alphavantage 时使用）
# STOCK_API_KEY=
# 自定义新闻接口：?q=... 返回 JSON；不设则走 yahoo
# STOCK_NEWS_URL=

# LSP：为 1 且提供 RAW_AGENT_LSP_COMMAND JSON，例如 {"command":"typescript-language-server","args":["--stdio"]}
# RAW_AGENT_LSP_ENABLED=0
# RAW_AGENT_LSP_COMMAND=

# 工具结果最大字符数（防止撑爆上下文）
# RAW_AGENT_TOOL_RESULT_MAX_CHARS=120000

# 会话循环守护：工具连续失败 / 相同工具调用内容 streak / 模型输出重复指纹（设 0 关闭）
# RAW_AGENT_RECOVERY_POLICY=1
# RAW_AGENT_RECOVERY_TOOL_FAIL_STREAK=3
# 相同调用 = 整轮 tool call 序列的 (name + 规范化参数) 指纹连续相同，不是只看首工具名
# RAW_AGENT_RECOVERY_SAME_TOOL_STREAK=5
# RAW_AGENT_RECOVERY_REPEAT_WINDOW=8
# RAW_AGENT_RECOVERY_REPEAT_RATIO=0.75
# LoopGuard 将 abort 时先宽限 N 轮并注入 recovery-advisory（默认开、预算 1；设 0 关闭宽限）
# RAW_AGENT_RECOVERY_ADVISORY_GRACE=1
# RAW_AGENT_RECOVERY_ADVISORY_GRACE_BUDGET=1

# 轮内复读 watchdog：上面的 LoopGuard 是「跨轮 + 工具中心」，看不见单条 assistant 里的
# token 退化刷屏（`覆盖覆盖覆盖…`），idle 超时也兜不住（一直在吐 token 不 idle）。
# 本 watchdog 在流式消费层按字符 run-length / 短 n-gram 占比检测，命中即 abort 本轮流
# （provider 立刻停止计费），再干净重答一次；第二次仍命中则不再重试、优雅收尾。
# RAW_AGENT_STREAM_WATCHDOG=1
# RAW_AGENT_STREAM_WATCHDOG_WINDOW=256
# RAW_AGENT_STREAM_WATCHDOG_MIN_LEN=80
# RAW_AGENT_STREAM_WATCHDOG_CHAR_RUN=50
# RAW_AGENT_STREAM_WATCHDOG_MAX_NGRAM=12
# RAW_AGENT_STREAM_WATCHDOG_NGRAM_RATIO=0.8
# RAW_AGENT_STREAM_WATCHDOG_NGRAM_MIN_REPEATS=3

# 思考空转 watchdog：thinking 模型连续多轮只产出 reasoning、无工具也无正文，
# 每轮重送整套 system+tools（LoopGuard 抓不到——每段 reasoning 文本都不同，指纹永不重复）。
# 命中**刻意不重试**（再问一次只是重送整套 schema 换同一份非答案），落盘已有产出后优雅收尾。
# RAW_AGENT_REASONING_SPIN_WATCHDOG=1
# RAW_AGENT_REASONING_SPIN_MAX=3

# Goal soft-gate（会话 metadata.goalCondition；软完成时判官 JSON；默认开）
# RAW_AGENT_GOAL_GATE=1
# RAW_AGENT_GOAL_MAX_TURNS=25

# RiskEngine 多信号 advisory（默认开）
# RAW_AGENT_RISK_ENGINE=1
# RAW_AGENT_RISK_TOOL_ERROR_STREAK=3
# RAW_AGENT_RISK_MAX_COACH=3
# RAW_AGENT_TOKEN_BUDGET=0

# Case governance（runSession 入口 fail-soft；默认开）
# RAW_AGENT_CASE_GOVERNANCE=1
# RAW_AGENT_CASE_HALF_LIFE_DAYS=30
# RAW_AGENT_CASE_CAPACITY=2000

# Token→USD 粗算（可选覆盖定价表 JSON：{ "gpt-4o-mini": { "input": 0.15, "output": 0.6 } }）
# RAW_AGENT_TOKEN_PRICE_JSON=

# Evolving：本地 agent_cases（FTS + 可选 embedding）；成功轮次后后台复盘写库；recovery 前注入 Coach；成功跟进时加权
# RAW_AGENT_EVOLVING=0
# RAW_AGENT_EVOLVING_REVIEWER=1
# RAW_AGENT_EVOLVING_COACH=1
# RAW_AGENT_EVOLVING_REVIEWER_TIMEOUT_MS=45000
# RAW_AGENT_EVOLVING_COACH_TOP_K=4
# RAW_AGENT_EVOLVING_FEEDBACK_DELTA=0.06
# RAW_AGENT_EVOLVING_EMBEDDINGS=0
# 记忆向量召回（Lab「记忆」面板 自动/开启/关闭）：自动模式下，配了下面任一 RAW_AGENT_EMBEDDING_* 且有可用 base URL + key 即启用；
# 只有对话 key 时不自动启用（第三方网关常无 /embeddings），可在面板里手动选「开启」复用。
# RAW_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# RAW_AGENT_EMBEDDING_BASE_URL=
# RAW_AGENT_EMBEDDING_API_KEY=
# 会话 metadata.evolvingNamespace → agent_cases.namespace（预留多租户扩展，当前不做隔离过滤）

# LLM 请求调试（脱敏后写入 stateDir/llm-debug/<sessionId>/requests.jsonl；MODE=logger 走日志）
# RAW_AGENT_DEBUG_LLM_PROMPT=1
# RAW_AGENT_DEBUG_LLM_PROMPT_MODE=file
# RAW_AGENT_DEBUG_LLM_PROMPT_MAX_CHARS=4000

# 可选工具组：1=仅暴露勾选分组内的「可选」工具（与 Agent allowedTools 求交）；见 GET /api/optional-tool-groups
# RAW_AGENT_OPTIONAL_TOOL_GROUPS=1
# RAW_AGENT_OPTIONAL_TOOL_GROUPS_PATH=
# 服务端默认启用的可选组 id（CSV），与会话 enabledOptionalToolGroups 取并集；合法 id 见 GET /api/optional-tool-groups
# RAW_AGENT_DEFAULT_ENABLED_OPTIONAL_GROUPS=shell,network


# OTLP：同一会话共用 traceId（便于 collector 里关联）
# RAW_AGENT_OTEL_SESSION_SCOPED_TRACE=1
# RAW_AGENT_OTEL_SERVICE_NAME=raw-agent

# 审批策略文件（仓库根 .raw-agent-policy.yaml），与 RAW_AGENT_APPROVAL_POLICY 合并
# 见 policy-loader：bashCommandPatterns、pathRules

# 工具钩子：可执行脚本，stdin 一行 JSON（phase/tool/sessionId/input）；stdout JSON { block?, message?, input?, permissionDecision?, systemMessage? }
# RAW_AGENT_HOOK_PRE_TOOL=
# RAW_AGENT_HOOK_POST_TOOL=
# RAW_AGENT_HOOK_SESSION_START=
# RAW_AGENT_HOOK_USER_PROMPT_SUBMIT=
# RAW_AGENT_HOOK_PRE_COMPACT=
# RAW_AGENT_HOOK_STOP=
# RAW_AGENT_HOOK_SUBAGENT_STOP=
# RAW_AGENT_HOOK_TIMEOUT_MS=30000

# 会话权限模式：plan | ask | acceptEdits | auto | bypass（也可写在 session.metadata.permissionMode）
# RAW_AGENT_PERMISSION_MODE=auto

# Prompt-cache 硬不变量：中途 toolset 漂移时抛错（默认仅 trace bust；1=fail-closed）
# RAW_AGENT_PROMPT_CACHE_STRICT=0

# Skills progressive disclosure（load_skill 截断 References/Scripts；默认开）
# RAW_AGENT_SKILL_PROGRESSIVE=1

# 可选浏览器工具（需同时启用 optional tool group browser；需本机 Playwright Chromium）
# RAW_AGENT_BROWSER_TOOLS=1
# 持久登录目录根。默认 <stateDir>/browser-profiles/<sessionId>（含 cookie，勿提交、勿写入日志）
# RAW_AGENT_BROWSER_PROFILE_DIR=

# 一等公民 cron 工具（cron_create/list/remove；daemon scheduler 会 tick）
# RAW_AGENT_CRON_TOOLS=1

# 可安装插件目录（冒号/逗号分隔；每子目录含 plugin.json）
# RAW_AGENT_PLUGINS_DIR=

# 可选 OTLP HTTP 导出（极简 span，非完整 SDK；无 Authorization，不能当 Langfuse）
# RAW_AGENT_OTEL_HTTP_ENDPOINT=
#
# Langfuse：入口与开关在 Lab「更多 → Langfuse」，保存后立即生效；不配入口不会上报。
# 下列密钥仅当 Lab 已保存入口且对应 KV 密钥为空时作回退（勿用 LANGFUSE_HOST / BASE_URL 自动开启）：
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Daemon 请求体最大字节数
# RAW_AGENT_MAX_BODY_BYTES=2000000

# 模型消费类端点（/api/chat、/api/sessions/:id/run|stream）的轻量 token-bucket 限流
# 默认每秒 1 次、突发 10；常驻进程，按 IP 维度
# RAW_AGENT_RATE_LIMIT_PER_SEC=1
# RAW_AGENT_RATE_LIMIT_BURST=10
# RAW_AGENT_RATE_LIMIT_IDLE_MS=300000

# 日志格式：pretty（默认，人类阅读）| json（NDJSON，便于 Loki/CW/Datadog 聚合）
# RAW_AGENT_LOG_FORMAT=json
# RAW_AGENT_LOG_LEVEL=info

# E5: 默认抑制 node:sqlite 实验性告警；设 1 恢复打印
# RAW_AGENT_KEEP_SQLITE_WARNING=1

# --- Capability Gateway（与 core 平级包 @ppeng/agent-capability-gateway，HTTP 前缀默认 /gateway/v1）---
# 设为 1 启用；见 gateway.config.example.json
# RAW_AGENT_GATEWAY_ENABLED=1
# RAW_AGENT_GATEWAY_PREFIX=/gateway/v1
# RAW_AGENT_GATEWAY_CONFIG=gateway.config.json
# 可选：X-Gateway-Token 或 Authorization: Bearer
# RAW_AGENT_GATEWAY_TOKEN=
# 定时 RSS 学习（每日 UTC 整点后首次 tick 跑一次）
# RAW_AGENT_GATEWAY_LEARN_ENABLED=1
# RAW_AGENT_GATEWAY_LEARN_HOUR_UTC=6

# 飞书 / Lark 机器人发消息（channels 里 type=feishu_bot 或 Feishu 事件回复）
# RAW_AGENT_FEISHU_APP_ID=
# RAW_AGENT_FEISHU_APP_SECRET=
# 国际版 Lark 时可改 API 根，例如 https://open.larksuite.com
# RAW_AGENT_FEISHU_API_BASE=https://open.feishu.cn

# --- A/B Release（Stable/Candidate，doc/SELF_EVOLUTION_AB_RELEASE.md）---
# EVOLUTION_RELEASE_ENABLED=1
# EVOLUTION_RELEASE_BACKEND=compose          # compose | helm（Compose 验证通过后切 helm）
# EVOLUTION_RELEASE_AUTO_PROMOTE=0           # MVP 默认手动 promote
# EVOLUTION_RELEASE_BAKE_HOURS=24
# EVOLUTION_RELEASE_FIX_MAX_ATTEMPTS=3
# EVOLUTION_RELEASE_CANDIDATE_URL=http://127.0.0.1:23001
# EVOLUTION_RELEASE_CANDIDATE_DAEMON_URL=http://127.0.0.1:27071
# EVOLUTION_RELEASE_STABLE_URL=http://127.0.0.1:23000
# EVOLUTION_RELEASE_STABLE_DAEMON_URL=http://127.0.0.1:37070   # promote 后部署冒烟打 Stable daemon；失败自动回滚到上一版 Stable
# EVOLUTION_RELEASE_EVOLUTION_ARGS=--learn --agent claude
# EVOLUTION_RELEASE_SKIP_EVOLUTION=0
# EVOLUTION_RELEASE_SKIP_DEPLOY=0
# EVOLUTION_RELEASE_SKIP_G2=0
# EVOLUTION_RELEASE_COMPOSE_PROJECT=ppeng-agent
# EVOLUTION_RELEASE_HELM_STABLE=ppeng-stable
# EVOLUTION_RELEASE_HELM_CANDIDATE=ppeng-candidate
# EVOLUTION_RELEASE_HELM_NAMESPACE=default
# EVOLUTION_RELEASE_GIT_REMOTE=origin
# EVOLUTION_RELEASE_GIT_BRANCH=main
# EVOLUTION_CODING_AGENT=cmd                 # cmd | claude-code | codex | pi
# EVOLUTION_CODING_BASE_URL=                 # 与 RAW_AGENT_* 分离的进化/修复模型端点
# EVOLUTION_CODING_API_KEY=
# EVOLUTION_CODING_MODEL_NAME=
# 入口：npm run release / release:promote / release:rollback / release:status

# --- Capability Discovery / Registry（≠ packages/capability-gateway）---
# 主开关请用 Lab → 更多 → 能力发现（PATCH /api/capabilities/settings，SQLite 持久化）。
# 下列 env 仅作 CI/评测、或「从未在界面保存过设置」时的回退，不是日常控制方式。
# RAW_AGENT_DISCOVERY=0
# RAW_AGENT_DISCOVERY_ACTIVE_SCAN=0
# RAW_AGENT_DISCOVERY_HOST_ALLOWLIST=
# RAW_AGENT_DISCOVERY_CIDR_ALLOWLIST=
# RAW_AGENT_TAILSCALE_DISCOVERY=0
# RAW_AGENT_TAILSCALE_API_CRED_REF=
# RAW_AGENT_TAILSCALE_STATUS_JSON=          # optional path to mock status.json for tests
# RAW_AGENT_TOOL_DISCLOSURE_BUDGET=20
# RAW_AGENT_TOOL_LOAD_STRICT=0
